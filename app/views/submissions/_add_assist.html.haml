-# requires *models*
  which is an array of llm names, e.g., ["gemini-2.5-pro", "Claude-3.5-Sonnet"] —
  the keys of Rails.configuration.llm[:provider]. The model is POSTed by name;
  CommentsController#can_request_llm validates it against that map.
- models.each do |model|
  .row
    - cost = Rails.configuration.llm[:provider][model].constantize::ASSIST_COST
    - body_text = render partial: 'comments/acquire_llm_assist_confirm', locals: {cost: cost, model: model}
    - confirmation = {title: "Confirm Submission for AI Help", body: body_text}
    .col
      AI help by
      %code #{model}
    .col-auto.pb-0.text-end
      = button_to "Get", llm_assist_submission_comments_path(@submission), params: {model: model},
        class: 'btn btn-link p-0 align-baseline',
        form: {class: 'd-inline', data: {turbo: true, turbo_confirm: confirmation.to_json}}
