.d-flex.flex-column.gap-1.mb-3
  %small.text-secondary.text-uppercase.fw-bold.ls-1 Report
  %h2.fw-bold.text-dark.mb-0 AI Assist

-# no contest picker here: this report reads the job queue by submission
-# number, which a per-student window does not fit; the contest's own AI
-# Usage page covers that case
.text-secondary.small.mb-3.d-flex.align-items-center.gap-1
  %span.mi.md-18 info
  For one contest's AI use (viva turns, grading and assists, with wait and AI times) open that contest's AI Usage page:
  = link_to 'Contests', contests_path
  → the contest → AI Usage.

= form_with url: '#', id: 'filter_form' do |f|
  .row{data: {controller: 'init-ui-component'}}
    .col-lg-4
      = render partial: 'problem_select', locals: {all: true}
    .col-lg-4
      = render partial: 'submission_range'
    .col-lg-4
      = render partial: 'user_select'

= render 'empty_report_notice'
= render 'report_help'

.col-sm-12{ data: { turbo: true,
    controller: 'datatables--init init-ui-component',
    'datatables--init-config-name-value': 'aiAssistReport',
    'datatables--init-ajax-url-value': ai_query_report_path
  }
}
  %table#table.table.table-hover.table-condense
