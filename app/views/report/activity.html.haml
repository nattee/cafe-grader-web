= render 'page_header', title: 'User Activity', path: activity_report_path
= render 'contest_scope', path: activity_report_path

= form_with url: '#', id: 'filter_form' do |f|
  -# with a contest picked the cards stay in the DOM (their JS feeds the
  -# table) but hidden; the query URL carries the contest and the
  -# controller ignores the card params
  .row{class: ('d-none' if @report_contest), data: {controller: 'init-ui-component'}}
    .col-lg-4.mt-2
      = render partial: 'problem_select', locals: {all: true}
    .col-lg-4.mt-2
      = render partial: 'submission_range'
    .col-lg-4.mt-2
      = render partial: 'user_select'
  .form-check.mt-2
    %input#show_inactive.form-check-input{type: :checkbox}
    %label.form-check-label{for: 'show_inactive'}
      Also show selected users with zero submissions
    .form-text= @report_contest ? 'Inactive rows are highlighted; lists the contest\'s students who never submitted in their window.' : 'Inactive rows are highlighted; applies to the user filter above.'

= render 'empty_report_notice'
= render 'report_help', extra_hint: 'Solved counts problems with a 100-point submission (raw-sum problems excluded).'

.row
  .col-sm-12
    %table#table.table.table-hover.table-condense.datatable{style: 'width: 100%'}

:javascript
  // contest-scoped: a student's link opens their stat for this contest
  user_path = "#{@report_contest ? stat_contest_user_admin_path(-1234, @report_contest) : stat_user_admin_path(-1234)}"

  function user_link_renderer(data, type, row) {
    if (type == 'display') {
      return `<a href="${user_path.replace("-1234",row['user_id'])}">${cafe.escapeHtml(row['login'])}</a>`;
    }
    return row['login']
  }
  function date_time_renderer(data, type, row) {
    if (data == null) { return (type == 'display' || type == 'filter') ? '—' : '' }
    if (type == 'display' || type == 'filter') {
      return moment(data).format('YYYY-MM-DD HH:mm:ss')
    }
    return data
  }

  window.addEventListener("load", function() {
    activity_table = $('#table').DataTable({
      layout: {
        topStart: 'buttons'
      },
      autoWidth: true,
      pageLength: 50,
      processing: true,
      order: [[2, 'desc']],
      buttons: [
        {
          text: 'Refresh',
          action: (e,dt,node,config) => {
            activity_table.clear().draw()
            activity_table.ajax.reload( () => { activity_table.columns.adjust().draw() } )
          }
        },
        'copy',
        {
          extend: 'excel',
          title: 'User activity'
        }
      ],
      columns: cafe.dt.escape_columns_by_default([
        {title: 'Login', data: 'login', render: user_link_renderer},
        {title: 'Name', data: 'full_name'},
        {title: 'Subs', data: 'sub_count', className: 'text-end'},
        {title: 'Problems tried', data: 'prob_count', className: 'text-end'},
        {title: 'Solved (=100)', data: 'solved_count', className: 'text-end'},
        {title: 'First sub', data: 'first_sub', render: date_time_renderer},
        {title: 'Last sub', data: 'last_sub', render: date_time_renderer},
        {title: 'IPs', data: 'ip_count', className: 'text-end'},
      ]),
      createdRow: (row, data) => {
        if (data.sub_count == 0) { $(row).addClass('table-danger') }
      },
      ajax: {
        url: '#{activity_query_report_path(report_contest_query)}',
        type: 'POST',
        data: (d) =>  {
          build_sub_range_params(d)
          build_user_params(d)
          build_problem_params(d)
          d.show_inactive = $('#show_inactive').is(':checked') ? 'true' : 'false'
        },
        dataType: 'json',
        beforeSend: (request) => {
          request.setRequestHeader('X-CSRF-Token', $('meta[name="csrf-token"]').attr('content'));
        },
      }, //end ajax
    });
  });
