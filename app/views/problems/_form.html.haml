- @active_problem_tab = '#general' unless %w[#general #description #hint].include? @active_problem_tab
=turbo_frame_tag :problem, data: {controller: 'init-ui-component bs-tab viva-exam-toggle', turbo: true} do
  %ul.nav.nav-tabs
    %li.nav-item
      %button.nav-link{data: {bs: {toggle: :tab, target: "#general"}},class: ('active' if @active_problem_tab == '#general') } General
    %li.nav-item
      %button.nav-link{data: {bs: {toggle: :tab, target: "#description"}},class: ('active' if @active_problem_tab == '#description')} Description
    %li.nav-item
      %button.nav-link{data: {bs: {toggle: :tab, target: "#hint"}},class: ('active' if @active_problem_tab == '#hint')} Hint
  = simple_form_for problem, wrapper: :horizontal_form do |form|
    -# this is to set the currently active tab of the problem
    %input{type: 'hidden', name: 'active_problem_tab', 'data-bs-tab-target': 'activeTabInput'}
    .tab-content
      %div#general.my-3.tab-pane.fade{class: (' show active ' if @active_problem_tab == '#general')}
        %section.mb-4
          %h5.fw-bold.text-body-emphasis.mb-3.pb-2.border-bottom Identity
          = form.input :name
          = form.input :full_name

        %section.mb-4
          %h5.fw-bold.text-body-emphasis.mb-3.pb-2.border-bottom Statement & Files
          = form.input :statement, wrapper: :horizontal_file
          .row
            .col-sm-3
            .col-sm-9
              %p.d-inline-flex.align-items-center.gap-1
                - if @problem.statement.attached?
                  = link_to "<span class='mi md-18 me-1'>description</span> Read (#{@problem.statement.filename})".html_safe, download_by_type_problem_path(@problem,'statement'), target: '_blank', data: {turbo: false}, class: 'link-flex'
                  = " | "
                  = link_to '<span class="mi md-18 me-1">delete</span> Delete'.html_safe, delete_by_type_problem_path(@problem,'statement'), class: 'link-flex link-danger', data: {turbo: true, turbo_method: 'delete', turbo_confirm: 'Delete the statement? This cannot be undone.'}
                - else
                  No statement uploaded.
          = form.input :attachment, wrapper: :horizontal_file
          .row
            .col-sm-3
            .col-sm-9
              %p.d-inline-flex.align-items-center.gap-1
                - if @problem.attachment.attached?
                  = link_to "<span class='mi md-18 me-1'>archive</span> File (#{@problem.attachment.filename})".html_safe, download_by_type_problem_path(@problem,'attachment'), target: '_blank', data: {turbo: false}
                  |
                  = link_to '<span class="mi md-18 me-1">delete</span> Delete'.html_safe, delete_by_type_problem_path(@problem,'attachment'), class: 'link-danger', data: {turbo: true, turbo_method: 'delete', turbo_confirm: 'Delete the attachment? This cannot be undone.'}
                - else
                  No attachment uploaded.

        %section.mb-4
          %h5.fw-bold.text-body-emphasis.mb-3.pb-2.border-bottom Categorization
          -# Exclude only viva_conduct (it has its own dedicated select below, id
          -# problem_conduct_tag_ids). llm_prompt tags MUST stay offered here — this
          -# is the only UI that attaches them, and tag_ids= is whole-collection
          -# replacement, so filtering llm_prompt out would silently detach a
          -# problem's AI-helper prompt tag on every ordinary save.
          = form.input :tag_ids, label: 'Tags', collection: Tag.where.not(kind: :viva_conduct), input_html: {class: 'select2', multiple: true}, wrapper: :horizontal_form, tooltip: "Tags marked public are shown to contestants on the main page."
          = form.input :difficulty, tooltip: 'Integer between 0 and 10.'

        %section.mb-4
          %h5.fw-bold.text-body-emphasis.mb-3.pb-2.border-bottom Visibility & Listing
          = form.input :date_added, input_html: {value: @problem.date_added&.strftime("%d/%b/%Y"), class: 'tempus-dominus'}, wrapper: :horizontal_form, as: :string, tooltip: 'Used as the main sort order for problems on the main page.'
          = form.input :available, wrapper: :horizontal_boolean, label: 'Globally Available', tooltip: 'If "Globally available" is not set, the problem will remain hidden from all contestants, even if enabled in groups or contests.' , disabled: @current_user.admin? == false
          = form.input :group_ids, label: 'Groups', collection: Group.all, input_html: {class: 'select2', multiple: true}, wrapper: :horizontal_form, hint: 'Groups control which students can see and submit this problem.'
          .form-text.text-secondary
            = link_to 'Manage groups', groups_path
          = form.input :view_testcase, wrapper: :horizontal_boolean, wrapper_html: {data: {'viva-exam-toggle-target': 'hideForViva'}}, disabled: @current_user.admin? == false
          = form.input :view_submission, wrapper: :horizontal_boolean, disabled: @current_user.admin? == false, hint: 'For viva problems: controls whether other students can see this viva transcript.'

        %section.mb-4
          %h5.fw-bold.text-body-emphasis.mb-3.pb-2.border-bottom Grading & Compilation
          = form.input :permitted_lang, label: 'Allowed Language', collection: Language.all, selected: @problem.get_permitted_lang_as_ids(when_blank: nil), input_html: {class: 'select2', multiple: true}, wrapper: :horizontal_form, wrapper_html: {data: {'viva-exam-toggle-target': 'hideForViva'}}, tooltip: 'Leave blank to allow any language.'
          - compilation_options = [['<strong>Self contained</strong> <span class="text-secondary">— the submission compiles by itself (most problems).</span>'.html_safe, 'self_contained'], ['<strong>With managers</strong> <span class="text-secondary">— the submission is compiled together with manager files attached to the dataset.</span>'.html_safe, 'with_managers'], ['<strong>Viva Exam</strong> <span class="text-secondary">— LLM-driven Socratic interview + rubric grading. No test-case dataset; fill in the Examiner briefing + optional Conduct profile and grounding materials instead.</span>'.html_safe, 'viva_exam']]
          = form.input :compilation_type, as: :radio_buttons, collection: compilation_options, wrapper: :horizontal_collection, input_html: {data: {action: 'change->viva-exam-toggle#toggle'}}, tooltip: 'See Help drawer (top-right) for details on each mode.'

          -# Viva grounding — shown only when compilation_type is viva_exam
          .mb-4.d-none{ data: { viva_exam_toggle_target: 'showForViva' } }
            = form.input :grounding_material_ids, label: 'Grounding materials',
                collection: GroundingMaterial.order(:title), value_method: :id, label_method: :title,
                input_html: { class: 'select2', multiple: true, id: 'problem_grounding_material_ids' },
                wrapper: :horizontal_form,
                hint: 'Reference material the interviewer/grader treat as authoritative. Re-sent every turn.'
            - attached = @problem.grounding_materials.to_a
            - if attached.any?
              .form-text.text-secondary
                Attached grounding ≈ #{number_with_delimiter(attached.sum(&:estimated_tokens))} tokens — re-sent every turn.
                %ul.mb-0
                  - attached.each do |gm|
                    %li
                      = gm.title
                      %span.text-secondary= "· ≈ #{number_with_delimiter(gm.estimated_tokens)} tokens ·"
                      = link_to 'view', edit_grounding_material_path(gm)

            = form.input :viva_prompt, as: :text, label: 'Examiner briefing', wrapper: :horizontal_form,
                wrapper_html: {data: markdown_editor_data},
                input_html: {rows: 14, class: 'font-monospace', data: markdown_editor_source},
                hint: 'Rubric, model answers, and problem-specific examiner guidance. NEVER shown to students. Must contain a "# Rubric" section. This is the marking scheme; the Scenario tab is the exam paper.'
            = form.input :tag_ids, label: 'Conduct profile', collection: Tag.viva_conduct.order(:name),
                input_html: {class: 'select2', multiple: true, id: 'problem_conduct_tag_ids'},
                wrapper: :horizontal_form,
                hint: 'Optional shared examiner persona/conduct layer (viva_conduct tags), prepended before the briefing. Usually one per course.'
            = form.input :viva_soft_cap, wrapper: :horizontal_form, label: 'Soft turn cap', hint: 'The examiner is instructed to wrap up within about this many questions.'
            = form.input :viva_hard_cap, wrapper: :horizontal_form, label: 'Hard turn cap', hint: 'The interview is force-ended and graded at this many student answers.'

            = form.input :viva_daily_limit, wrapper: :horizontal_form, label: 'Daily start limit', hint: 'Starts per student per day outside contests. Blank = site default; 0 = can only be taken during a contest.'

          = form.input :submission_filename, wrapper_html: {data: {'viva-exam-toggle-target': 'hideForViva'}}

        = form.button :submit, class: 'btn btn-primary me-2'
      %div#description.my-3.tab-pane.fade{class: (' show active ' if @active_problem_tab == '#description')}
        %section.mb-4
          %h5.fw-bold.text-body-emphasis.mb-3.pb-2.border-bottom
            = @problem.viva_exam? ? 'Scenario (markdown)' : 'Markdown Statement'
          = form.input :description, as: :text, wrapper: :vertical_form, label: false, wrapper_html: {data: markdown_editor_data}, input_html: { rows: 20, class: 'font-monospace', data: markdown_editor_source }
          %p.small.text-secondary.mt-1.mb-0
            - if @problem.viva_exam?
              Sent <strong>verbatim to the examiner</strong> as the interview opener — this is the exam paper (the case being discussed). Rubric and model answers belong in the Examiner briefing, never here. The statement PDF (General tab) is only needed when the scenario requires figures or original exam layout.
            - else
              Internal markdown source — not shown to students directly. The PDF below is auto-regenerated whenever you save changes to the description.

        - unless @problem.viva_exam?
          %section.mb-4
            %h5.fw-bold.text-body-emphasis.mb-3.pb-2.border-bottom PDF Export
            .d-flex.align-items-center.justify-content-between.flex-wrap.gap-2
              -# Current PDF state
              - if @problem.generated_statement.attached?
                .d-inline-flex.align-items-center.gap-1
                  %span.mi.md-18.text-secondary description
                  = link_to @problem.generated_statement.filename.to_s, download_by_type_problem_path(@problem, 'generated_statement'), target: '_blank', data: {turbo: false}, class: 'text-decoration-none'
              - else
                %span.text-secondary.fst-italic No PDF generated yet.

              -# Delete button references the hidden form below via HTML5
              -# `form=` attr, so the button can live inside this
              -# simple_form_for without producing illegal nested <form> tags.
              -# To force a fresh PDF without changing description, edit and
              -# resave (any description change re-fires the auto-generation).
              - if @problem.generated_statement.attached?
                %button.btn.btn-sm.btn-outline-danger.d-inline-flex.align-items-center.gap-1{type: 'submit', form: 'pdf-delete-form'}
                  %span.mi.md-18 delete
                  Delete

        = form.button :submit, class: 'btn btn-primary me-2'

  -# Hidden form for the PDF delete action — lives OUTSIDE simple_form_for
  -# so the visible button inside the Description tab (which references it
  -# by HTML5 `form="…"` attribute) doesn't produce nested <form> tags
  -# (HTML disallows that; browsers handle the malformed DOM inconsistently).
  - if @problem.generated_statement.attached?
    = form_with url: delete_by_type_problem_path(@problem, 'generated_statement'), method: :delete, html: {id: 'pdf-delete-form', class: 'd-none', data: {turbo: true, 'turbo-confirm': 'Delete the generated PDF? This cannot be undone.'}} do
      -# CSRF token + `_method=delete` are auto-added; body intentionally empty.

  .tab-content
    %div#hint.tab-pane.fade.my-3{class: (' show active ' if @active_problem_tab == '#hint'), data: {controller: 'children-select'}}
      %section.mb-4
        %h5.fw-bold.text-body-emphasis.mb-3.pb-2.border-bottom Hints
        -# hint selector (dropdown + Add/Delete row)
        = turbo_frame_tag :hint_select do
          = render partial: 'hint_select', locals: {ds: @problem.live_dataset, problem: @problem}
        -# hint detail editor (lazy-loaded for the selected hint)
        = turbo_frame_tag :hint_detail, src: edit_problem_hint_index_path(@problem,@problem.hints.first)


