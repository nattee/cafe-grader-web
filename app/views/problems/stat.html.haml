.d-flex.justify-content-between.align-items-center.flex-wrap.gap-2.mb-2
  = render partial: 'problems/problem_head', locals: {problem: @problem}
  -# Toolbar. Anyone who reaches this page passed can_report_problem, so the
  -# report link needs no extra gate. The report opens with this problem
  -# preselected and @report_group (Problem#report_group_for: the section
  -# that actually has submissions) pre-picked, so it loads with that
  -# section's scores; switching the group there compares sections. Labeled
  -# (not icon-only) on purpose: this is a discoverability link, same
  -# reasoning as the "? Help" buttons.
  - report_tip = @report_group ? "Best Score report for this problem, opened on the #{@report_group.name} group — switch the group there to compare sections" : "Best Score report for this problem — choose a user group there to compare sections"
  .d-flex.gap-2.align-items-center{data: {controller: 'init-ui-component'}}
    = link_to problem_score_report_path(@problem, @report_group), class: 'btn btn-sm bg-white shadow-sm border-0 text-secondary d-inline-flex align-items-center gap-1', data: {bs_toggle: 'tooltip', bs_title: report_tip} do
      %span.mi table_view
      Score report

.row
  .col-md-8
    .card.mb-4
      .card-body
        %h2.card-title Submission History
        %canvas#chart{height: '50px', data: { controller: 'chart', chart_data_value: @chart_dataset }}

    -# One row per section (group) the viewer may report on, so sections can
    -# be compared at a glance — the Best Score report shows one group at a
    -# time. Rows link to that report pre-filtered to the group. A user in
    -# several groups counts in each row, so these rows can sum to more than
    -# the distinct-user summary in General Info; that is expected.
    - if @group_stats.any?
      .card.mb-4#by-group-card
        .card-body
          %h2.card-title By group
          %p.text-secondary.small.mb-2
            Enabled members with the
            %em user
            role only; a student in several groups counts in each.
            Mean best is over students who attempted.
          .table-responsive
            %table.table.table-sm.table-hover.align-middle.mb-0
              %thead
                %tr
                  %th Group
                  %th.text-end Members
                  %th.text-end Solved / Attempted
                  %th.text-end Solved %
                  %th.text-end Mean best
              %tbody
                - @group_stats.each do |row|
                  %tr
                    %td
                      = link_to row.group.name, problem_score_report_path(@problem, row.group), class: 'text-decoration-none fw-semibold', title: "Best Score report for #{row.group.name}"
                      - unless row.group.enabled
                        %span.badge.text-bg-secondary.ms-1 archived
                    %td.text-end= row.users
                    %td.text-end #{row.solved} / #{row.attempted}
                    %td.text-end
                      - if row.attempted.zero?
                        %span.text-secondary —
                      - else
                        #{(row.solved * 100.0 / row.attempted).round(1)}%
                    %td.text-end
                      - if row.mean_best.nil?
                        %span.text-secondary —
                      - else
                        = row.mean_best

  .col-md-4
    .card.mb-4
      .card-body
        %h2.card-title General Info
        .row.my-2
          .col-sm-6.text-end.text-secondary
            Name
          .col-sm-6{data: {controller: 'problem-name'}}
            = render partial: 'problem_name', locals: {problem: @problem}
            - if @current_user.admin?
              = link_to 'Edit', edit_problem_path(@problem)
              |
              = link_to 'Stat', stat_problem_path(@problem)
        .row.my-2
          .col-sm-6.text-end.text-secondary
            Subs
          .col-sm-6
            = @submission_count
        .row.my-2
          .col-sm-6.text-end.text-secondary
            Solved/Attempted User
          .col-sm-6
            -# Distinct users across every group (Problem#attempt_summary).
            -# Guard the percentage: with no submissions this is 0.0/0, and Ruby
            -# yields NaN rather than raising (NaN.round(1) is NaN), so the page
            -# used to render the literal "0/0 (NaN%)".
            - if @summary[:attempted].zero?
              %span.text-secondary No submissions yet
            - else
              #{@summary[:solved]}/#{@summary[:attempted]} (#{(@summary[:solved] * 100.0 / @summary[:attempted]).round(1)}%)

%h2 Submissions
-# Rows arrive as JSON from #stat_query and are paged client-side, so the page
-# paints before a single row is rendered. Columns go through
-# cafe.dt.escape_columns_by_default (CLAUDE.md, "JSON-fed DataTables").
%table#main_table.table.table-hover.table-condense.align-middle{style: 'width: 100%'}
  %thead
    %tr
      %th ID
      %th Login
      %th Name
      %th Language
      %th Submitted at
      %th Result
      %th.text-end Score
      %th IP
  %tbody

:javascript
  window.addEventListener("load", function() {
    // Verdict tiles (or plain text, per the viewer's preference) — same
    // renderer and config as the Submission report.
    const VERDICT_STRIP = #{verdict_strip_config_json}
    const verdictRenderer = (data, type) => type === 'display' ? cafe.verdictStrip(data, VERDICT_STRIP) : data
    // "2019-10-22 15:34 (6 years ago)" for display; the raw ISO string sorts.
    const dateAgoRenderer = (data, type) => {
      if (type !== 'display') return data
      const m = moment(data)
      return `${m.format('YYYY-MM-DD HH:mm')} <span class="text-secondary">(${m.fromNow()})</span>`
    }

    $("#main_table").DataTable({
      ajax: {
        url: "#{stat_query_problem_path(@problem)}",
        type: 'POST',
        dataType: 'json',
        headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') },
      },
      processing: true,
      deferRender: true,
      paging: true,
      pageLength: 50,
      order: [[0, 'asc']],
      columns: cafe.dt.escape_columns_by_default([
        { data: 'id',           render: cafe.dt.render.link(null, { path: "#{submission_path(-123)}" }) },
        { data: 'login',        render: cafe.dt.render.link(null, { path: "#{stat_user_admin_path(-123)}", replace_field: 'user_id' }) },
        { data: 'full_name' },
        { data: 'pretty_name' },
        { data: 'submitted_at', render: dateAgoRenderer },
        { data: 'grader_comment', render: verdictRenderer },
        { data: 'points',       className: 'text-end' },
        { data: 'ip_address' },
      ]),
    });
  });
