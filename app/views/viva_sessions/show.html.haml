%h2= "Viva Session: ##{@submission.id}"

.row
  .col-lg-8
    = render partial: 'viva_session', locals: {submission: @submission, turns: @turns, viva_grade: @viva_grade, pending_turn: @pending_turn, finished: @finished}
  .col-lg-4{data: {controller: 'init-ui-component'}}
    .card.shadow-sm.mb-3
      .card-body
        %h4 Viva Info
        .row.mb-2
          .col-5.text-end.text-secondary Problem
          .col
            = @submission.problem.full_name
            -# PDF is the interviewer's brief on viva problems — hide
            -# it from the student. Single-page lookup so the predicate
            -# is fine here (unlike /main/list, which would N+1).
            - if @submission.problem.statement.attached? && @current_user.can_view_problem_pdf?(@submission.problem)
              = link_to mdi(:description, 'md-18 text-muted ms-1'), download_by_type_problem_path(@submission.problem, 'statement'), class: 'd-inline-flex text-decoration-none align-middle', data: {bs_toggle: 'tooltip', bs_title: 'Download problem statement (PDF)'}
        .row.mb-2
          .col-5.text-end.text-secondary User
          .col= @submission.user.login
        .row.mb-2
          .col-5.text-end.text-secondary Started
          .col= "#{time_ago_in_words(@submission.submitted_at)} ago"
        .row.mb-2
          .col-5.text-end.text-secondary Status
          .col
            = @submission.status
            - if @submission.viva_archived?
              %span.badge.text-bg-warning.ms-1 archived
            = submission_test_drive_badge(@submission)
        .row.mb-2
          .col-5.text-end.text-secondary Turns
          .col= @submission.viva_turns.where(role: :student).count
        - if @submission.points
          .row.mb-2
            .col-5.text-end.text-secondary Points
            .col= "#{@submission.points}/100"
        - if @submission.viva_archived?
          .row.mb-2
            .col-5.text-end.text-secondary Archived
            .col
              = "#{time_ago_in_words(@submission.viva_archived_at)} ago"
              %div.small.text-secondary.fst-italic
                - if @submission.points
                  This session is closed; its score still counts toward the best.
                - elsif @submission.status.to_s == 'evaluating'
                  This session is closed; its grade still counts toward the best once grading finishes.
                - else
                  This session was closed without a grade.
                A fresh session can be started from the problem list when a start is left.

        .row.mb-2
          .col-5.text-end.text-secondary Starts
          .col
            - if @submission.test_drive?
              Test-drive — unlimited restarts; excluded from reports, cost figures and start limits
            - elsif @current_user == @submission.user && @current_user.admin?
              Unlimited starts (admin)
            - elsif @submission.problem.viva_daily_limit == 0
              - if GraderConfiguration.contest_mode?
                = "Contest-only viva — #{@starts_left} of 1 attempt left today"
              - else
                Contest-only viva — can be taken only during a contest
            - else
              = "#{@starts_left} of #{@daily_start_limit} starts left today"
        - if @submission.viva_retake_granted_at
          .row.mb-2
            .col-5.text-end.text-secondary Retake
            .col
              = "Another attempt allowed by #{@submission.viva_retake_granted_by&.login || 'staff'}, #{time_ago_in_words(@submission.viva_retake_granted_at)} ago"
              %div.small.text-secondary.fst-italic This session does not count toward the start limit.

        - if @current_user == @submission.user && @submission.viva_archived_at.nil?
          - if @submission.status.to_s == 'submitted' && (@submission.problem.viva_daily_limit != 0 || @submission.test_drive?) && @submission.viva_turns.where(role: :student).exists?
            = button_to 'End interview & get graded', viva_finish_submission_path(@submission),
                class: 'btn btn-sm btn-success mt-2 me-1',
                form: {class: 'd-inline', data: {turbo: true, 'turbo-confirm': 'End the interview now and get graded? Topics not yet discussed will score zero.'}}
          - if @submission.test_drive?
            = button_to 'Restart test-drive', viva_restart_submission_path(@submission),
                class: 'btn btn-sm btn-warning mt-2',
                form: {class: 'd-inline', data: {turbo: true, 'turbo-confirm': 'Archive this test-drive and open a fresh one right away?'}}
          - elsif @restart_allowed
            = button_to 'Restart viva', viva_restart_submission_path(@submission),
                class: 'btn btn-sm btn-warning mt-2',
                form: {class: 'd-inline', data: {turbo: true, 'turbo-confirm': 'Archive this session and start over? The transcript is kept for instructors.'}}

    - if @current_user.can_edit_problem?(@submission.problem)
      - grader_class = (Rails.configuration.llm[:viva_grade_service].presence || 'Llm::VivaGradeAssist').constantize
      - known_models = grader_class.const_defined?(:KNOWN_MODELS) ? grader_class::KNOWN_MODELS : []

      .card.shadow-sm.mb-3
        .card-body
          %h5 Admin
          = form_with url: rejudge_submission_path(@submission), method: :post,
                      html: {data: {turbo: true, 'turbo-confirm': 'Re-run grading? The current grade is kept in the history.'}} do |f|
            .input-group.input-group-sm
              = f.select :model,
                  [['Default model', '']] + known_models.map { |m| [m, m] },
                  {},
                  class: 'form-select form-select-sm',
                  title: 'Model to use for the next grader run'
              = f.submit 'Re-run grading', class: 'btn btn-warning btn-sm'
            .form-check.mt-1
              = f.check_box :never_lower, {checked: true, class: 'form-check-input', id: 'rejudge-never-lower'}, '1', '0'
              = f.label :never_lower, 'Keep the higher grade', class: 'form-check-label small', for: 'rejudge-never-lower',
                  title: 'If the new run scores lower, the current grade stays and the run is kept in the history'

          -# "Allow another attempt" (design 2026-10-07, A4): any status,
          -# archived or not; the session stops counting toward the start limit.
          - if @submission.viva_retake_granted_at
            .small.text-secondary.mt-2
              %em Another attempt allowed #{time_ago_in_words(@submission.viva_retake_granted_at)} ago
              = "by #{@submission.viva_retake_granted_by&.login || 'staff'}."
          - elsif !@submission.test_drive?
            = button_to 'Allow another attempt', allow_viva_retake_submission_path(@submission),
                class: 'btn btn-warning btn-sm mt-2',
                data: {bs_toggle: 'tooltip', bs_title: 'Archives this session (even mid-interview; kept for reports and audit) and stops it counting toward the start limit, so the student can start one more. Their best score still counts.'},
                form: {class: 'd-inline', data: {turbo: true, 'turbo-confirm': "Allow #{@submission.user.login} another attempt? This session is archived and stops counting toward the start limit; an unfinished interview is not graded."}}

          = render partial: 'viva_sessions/grade_history', locals: {submission: @submission}

      -# Editor-visible diagnostics: request payload previews, per-turn raw responses (grader responses live in the Admin card's grade history).
      .card.shadow-sm.mb-3
        .card-body
          %h5.mb-2 Debug
          -# Request preview — what would be sent on the next grader call.
          -# Computed lazily here; pdf_attachment downloads + base64-encodes
          -# so this adds ~50–100ms to admin page loads. Acceptable for
          -# editor-only sidebar that isn't part of the polling refresh.
          - request_payload = (grader_class.preview(submission: @submission) rescue nil)
          - if request_payload
            %details.mt-2
              %summary.text-secondary.small Grader request payload (next run)
              %pre.small.bg-light.p-2.mt-1.mb-0{style: 'white-space: pre-wrap; word-break: break-word; max-height: 40vh; overflow-y: auto;'}
                = JSON.pretty_generate(request_payload)

          - turn_class = (Rails.configuration.llm[:viva_turn_service].presence || 'Llm::VivaTurnAssist').constantize
          - turn_payload = (turn_class.preview(submission: @submission, turn: nil) rescue nil)
          - if turn_payload
            %details.mt-2
              %summary.text-secondary.small Turn request payload (next turn would send)
              %pre.small.bg-light.p-2.mt-1.mb-0{style: 'white-space: pre-wrap; word-break: break-word; max-height: 40vh; overflow-y: auto;'}
                = JSON.pretty_generate(turn_payload)

          -# Per-turn raw responses — what each interview-turn LLM call returned.
          - turns_with_raw = @submission.viva_turns.where(role: :assistant).where.not(llm_response_raw: nil).order(:id)
          - if turns_with_raw.any?
            .border-top.pt-2.mt-3
              %h6.text-secondary.small.mb-1 Per-turn responses
              - turns_with_raw.each do |t|
                %details.mt-1
                  %summary.text-secondary.small
                    Turn ##{t.id}
                    - if t.llm_model.present?
                      | · #{t.llm_model}
                    - if t.cost
                      | · $#{format('%.4f', t.cost)}
                    - if t.token_count_in || t.token_count_out
                      | · #{t.token_count_in || 0}/#{t.token_count_out || 0} tok
                  %pre.small.bg-light.p-2.mt-1.mb-0{style: 'white-space: pre-wrap; word-break: break-word; max-height: 40vh; overflow-y: auto;'}
                    = t.llm_response_raw
