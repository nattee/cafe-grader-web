# Per-host OVERRIDES for the Solid Queue service. Not a config of its own:
# the defaults live in config/queue.yml (threads) and config/database.yml (pool).
# Copy to config/solid_queue.env only on a host that must deviate, keep only
# the lines that deviate, never restate a default. Read by the systemd unit via
#   EnvironmentFile=-/home/dae/cafe_grader/web/config/solid_queue.env
# Rule: every worker's threads <= RAILS_MAX_THREADS - 1.
# The values a host really runs are shown on Manage -> Grader Processes.
#VIVA_JOB_THREADS=5
#JOB_THREADS=5
#RAILS_MAX_THREADS=12
